# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://fr:fr@localhost:5432/fashion_rockstar?schema=public"

# ---- Public site URL (used for Stripe redirects, sitemap, canonical URLs) ----
SITE_URL="http://localhost:3000"

# ---- Admin login ----
# Long random string used to sign admin session cookies (openssl rand -hex 32)
SESSION_SECRET="change-me-to-a-long-random-string"
# The seed script creates (or resets) this super-admin account
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-this-password"

# ---- Payments (Stripe) — use test keys until your account is verified ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- AI chat assistant (Claude) — leave empty to disable AI replies ----
ANTHROPIC_API_KEY=""

# ---- Human support (WhatsApp / phone) — international format, digits only, e.g. 447700900123 ----
# Can also be changed later in Admin → Settings.
SUPPORT_WHATSAPP_NUMBER=""

# ---- Uploaded product images are stored here (use object storage in production) ----
UPLOAD_DIR="./storage/uploads"
